---
import Base from '../layouts/Base.astro';
import PracticeSteps from '../components/PracticeSteps.astro';
import PracticeTips from '../components/PracticeTips.astro';

const game = '/practice/web/v7/formmaster_session.html';
---

<Base title="Practice" description="Run a timed cross-contour practice session in your browser.">
  <section class="page wrap desk" aria-labelledby="practice-title">
    <header class="desk-head">
      <div>
        <p class="label">Practice session</p>
        <h1 id="practice-title">Begin your practice</h1>
      </div>
      <p class="lede">
        Select your <strong>preferred settings</strong> for the session, including the type of feedback and
        duration.
      </p>
    </header>

    <div class="game" data-game>
      <iframe
        src={game}
        title="Loop Master practice session"
        allow="fullscreen"
        sandbox="allow-same-origin allow-popups allow-top-navigation-by-user-activation allow-scripts allow-modals allow-downloads allow-pointer-lock allow-presentation"
      ></iframe>
      <button class="exit label" type="button" data-exit>Exit focus ✕</button>
    </div>

    <div class="toolbar">
      <button class="btn" type="button" data-focus>
        <svg viewBox="0 0 16 16" aria-hidden="true"><path d="M1 5V1h4M11 1h4v4M15 11v4h-4M5 15H1v-4" /></svg>
        Focus mode
      </button>
      <a class="label" href={game} target="_blank" rel="noopener">Open in new window ↗</a>
      <a class="label" href="https://zinnia-art.itch.io/loop-master" rel="noopener">Use Loop Master on itch.io ↗</a>
      <p class="phone-note label">Best on a tablet or computer with a pen or mouse.</p>
    </div>
  </section>

  <PracticeSteps />
  <PracticeTips />
</Base>

<script>
  const game = document.querySelector<HTMLElement>('[data-game]');
  const focusBtn = document.querySelector<HTMLButtonElement>('[data-focus]');
  const exitBtn = document.querySelector<HTMLButtonElement>('[data-exit]');

  if (game && focusBtn && exitBtn) {
    // Real fullscreen where the browser allows it on an element; otherwise
    // (e.g. iPhone Safari) fill the viewport with CSS.
    const canFullscreen = document.fullscreenEnabled && typeof game.requestFullscreen === 'function';
    const setCssFocus = (on: boolean) => {
      game.classList.toggle('is-focus', on);
      document.documentElement.classList.toggle('no-scroll', on);
    };

    focusBtn.addEventListener('click', async () => {
      if (canFullscreen) {
        try {
          await game.requestFullscreen();
          return;
        } catch {
          /* fall through to the CSS version */
        }
      }
      setCssFocus(true);
    });
    exitBtn.addEventListener('click', () => {
      if (document.fullscreenElement) document.exitFullscreen();
      setCssFocus(false);
    });
    document.addEventListener('keydown', (e) => {
      if (e.key === 'Escape' && game.classList.contains('is-focus')) setCssFocus(false);
    });
    // Hand keyboard focus to the game when entering focus mode.
    const focusGame = () => game.querySelector('iframe')?.focus();
    document.addEventListener('fullscreenchange', () => document.fullscreenElement && focusGame());
  }
</script>

<style>
  .desk-head {
    display: grid;
    grid-template-columns: auto minmax(0, 1fr);
    align-items: end;
    gap: 16px 48px;
    margin-bottom: 24px;
  }
  .desk-head h1 { font-size: clamp(2.25rem, 5vw, 3.75rem); margin: 0; }
  .desk-head .lede { margin: 0; max-width: 46ch; justify-self: end; color: var(--muted); }
  .lede strong { color: var(--accent); font-weight: 500; }
  @media (max-width: 860px) {
    .desk-head { grid-template-columns: minmax(0, 1fr); }
    .desk-head .lede { justify-self: start; }
  }

  .game {
    position: relative;
    width: 100%;
    height: clamp(420px, calc(100svh - 300px), 900px);
    background: #000;
    border: 1px solid var(--line-dim);
    border-radius: var(--radius);
    overflow: hidden;
  }
  .game iframe { position: absolute; inset: 0; width: 100%; height: 100%; border: 0; }

  /* Focus mode: real fullscreen, or the CSS fallback. */
  .game:fullscreen { border: 0; border-radius: 0; height: 100%; }
  .game.is-focus {
    position: fixed;
    inset: 0;
    z-index: 100;
    height: auto;
    border: 0;
    border-radius: 0;
  }
  .exit {
    display: none;
    position: absolute;
    top: 12px;
    right: 12px;
    padding: 8px 12px;
    background: rgb(0 15 7 / 0.85);
    color: var(--line);
    border: 1px solid var(--line-dim);
    border-radius: var(--radius);
    cursor: pointer;
  }
  .game:fullscreen .exit,
  .game.is-focus .exit { display: block; }
  :global(html.no-scroll) { overflow: hidden; }

  .toolbar {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 12px 24px;
    margin-top: 16px;
  }
  .toolbar .btn svg { width: 14px; height: 14px; fill: none; stroke: currentColor; stroke-width: 1.8; }
  .toolbar a { color: var(--line); }
  .phone-note { display: none; margin: 0; flex-basis: 100%; color: var(--accent); }
  @media (max-width: 760px), (pointer: coarse) and (max-width: 900px) {
    .phone-note { display: block; }
  }
</style>
