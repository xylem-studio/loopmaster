---
import Base from '../layouts/Base.astro';
import Hero from '../components/Hero.astro';
import TryLoop from '../components/TryLoop.astro';
import HowItWorks from '../components/HowItWorks.astro';
import Spread from '../components/Spread.astro';
import Specimens from '../components/Specimens.astro';
import XRay from '../components/XRay.astro';
import sceneDrawing from '../assets/img/home-scene-laptop-egg.jpg';
import sceneMonitors from '../assets/img/home-scene-monitors-drawing.jpg';
---

<Base>
  <Hero />
  <TryLoop />
  <HowItWorks />

  <Spread
    num="01"
    side="left"
    label="For every level"
    title="Designed for artists of all levels"
    ratio="3 / 2"
    fade="soft"
    position="50% 50%"
    wide
    image={sceneDrawing}
    alt="An artist sketches an egg with cross-contour loops while a laptop running Loop Master shows the same egg with orange hint loops"
    caption="Fig. 01 — From screen to paper"
    cta={{ href: '/practice/', text: 'Start Drawing' }}
  >
    <p>Practice building 3D forms with cross-contour loops, against the clock.</p>
  </Spread>

  <Specimens />

  <Spread
    num="03"
    label="Generated forms"
    title="New Shapes for Every Practice!"
    ratio="3 / 2"
    fade="soft"
    position="0% 50%"
    image={sceneMonitors}
    alt="A desk with two monitors, Loop Master showing a cube with its feedback and a drawing app with the shapes sketched, and the same sketch in an open notebook"
    caption="Fig. 03 — A new form, every session"
    cta={{ href: '/practice/', text: 'Start Drawing' }}
  >
    <p>Every session brings new shapes, so you never draw the same view twice.</p>
  </Spread>

  <XRay />
</Base>
