---
import { Image } from 'astro:assets';
import archer from '../assets/img/home-archer.jpg';
import { archerConstruction, ARCHER_VIEWBOX } from '../lib/archer-construction';

const c = archerConstruction();
const sizes = '(max-width: 860px) 100vw, 560px';
---

<section class="section xray" aria-labelledby="xray-title">
  <div class="wrap layout">
    <span class="num" aria-hidden="true">04</span>

    <div class="stage" data-xray>
      <Image class="art" src={archer} alt="Illustration of an elegant archer drawing her longbow, outlined in orange light" widths={[480, 800, 1200]} sizes={sizes} />
      <div class="lens" aria-hidden="true">
        <Image class="art ghost" src={archer} alt="" widths={[480, 800, 1200]} sizes={sizes} />
        <svg viewBox={ARCHER_VIEWBOX}>
          <path class="gesture" d={c.gesture} />
          {c.dashed.map((d) => <path class="hid" d={d} />)}
          {c.solid.map((d) => <path d={d} />)}
        </svg>
      </div>
      <div class="ring" aria-hidden="true"></div>
      <button class="toggle label" type="button" aria-pressed="false">X-ray</button>
    </div>

    <div class="copy">
      <p class="label">Construction</p>
      <h2 id="xray-title">Enhance your construction skills</h2>
      <p>
        Regular practice with this tool will boost your construction skills, which are essential for both 2D and
        3D art.
      </p>
      <p class="hint label">Move over the drawing to see what holds it up.</p>
      <a class="btn" href="/practice/">Start Practicing</a>
    </div>
  </div>
</section>

<script>
  const stage = document.querySelector<HTMLElement>('[data-xray]');
  const toggle = stage?.querySelector<HTMLButtonElement>('.toggle');
  if (stage && toggle) {
    const move = (e: PointerEvent) => {
      const r = stage.getBoundingClientRect();
      stage.style.setProperty('--x', `${e.clientX - r.left}px`);
      stage.style.setProperty('--y', `${e.clientY - r.top}px`);
    };
    stage.addEventListener('pointerenter', (e) => {
      move(e);
      stage.classList.add('is-looking');
    });
    stage.addEventListener('pointermove', move);
    stage.addEventListener('pointerleave', () => stage.classList.remove('is-looking'));
    toggle.addEventListener('click', () => {
      const on = stage.classList.toggle('is-full');
      toggle.setAttribute('aria-pressed', String(on));
    });
  }
</script>

<style>
  @property --r {
    syntax: '<length>';
    inherits: true;
    initial-value: 0px;
  }

  .xray { border-top: 1px solid var(--line-dim); overflow: hidden; }
  .layout {
    position: relative;
    display: grid;
    grid-template-columns: repeat(12, minmax(0, 1fr));
    align-items: end;
  }
  .num {
    position: absolute;
    top: -0.1em;
    right: var(--gutter);
    font-family: var(--font-display);
    font-size: clamp(8rem, 26vw, 22rem);
    line-height: 0.8;
    color: transparent;
    -webkit-text-stroke: 1.5px var(--line-dim);
    pointer-events: none;
    user-select: none;
  }

  .stage {
    --x: 50%;
    --y: 40%;
    --r: 0px;
    position: relative;
    grid-column: 1 / 7;
    grid-row: 1;
    aspect-ratio: 1493 / 2000;
    cursor: crosshair;
    touch-action: pan-y;
    transition: --r 0.35s ease;
  }
  .stage.is-looking { --r: clamp(90px, 14vw, 160px); }
  .stage.is-full { --r: 150vmax; }
  .stage :global(.art) { position: absolute; inset: 0; width: 100%; height: 100%; }

  .lens {
    position: absolute;
    inset: 0;
    background:
      linear-gradient(rgb(255 153 51 / 0.08) 1px, transparent 1px) 0 0 / 32px 32px,
      linear-gradient(90deg, rgb(255 153 51 / 0.08) 1px, transparent 1px) 0 0 / 32px 32px,
      var(--ink);
    -webkit-mask-image: radial-gradient(circle var(--r) at var(--x) var(--y), #000 99%, transparent 100%);
    mask-image: radial-gradient(circle var(--r) at var(--x) var(--y), #000 99%, transparent 100%);
  }
  .lens :global(.ghost) { opacity: 0.16; filter: grayscale(1); }
  .lens svg { position: absolute; inset: 0; width: 100%; height: 100%; }
  /* Bold, confident strokes: a demo sketch, not a diagram. (viewBox units, ~0.37px each) */
  .lens path { fill: none; stroke: var(--accent); stroke-width: 7; stroke-linecap: round; stroke-linejoin: round; }
  .lens path.hid { stroke-width: 5; stroke-dasharray: 16 18; opacity: 0.55; }
  .lens path.gesture { stroke: var(--line); stroke-width: 5; opacity: 0.7; }

  .ring {
    position: absolute;
    left: var(--x);
    top: var(--y);
    width: calc(var(--r) * 2);
    height: calc(var(--r) * 2);
    translate: -50% -50%;
    border: 1px solid var(--accent);
    border-radius: 50%;
    pointer-events: none;
  }
  .is-full .ring { display: none; }

  .toggle {
    position: absolute;
    left: 0;
    bottom: 0;
    padding: 6px 10px;
    background: var(--ink);
    border: 1px solid var(--line-dim);
    border-radius: var(--radius);
    color: var(--line);
    cursor: pointer;
  }
  .toggle[aria-pressed='true'] { color: var(--ink); background: var(--accent); border-color: var(--accent); }

  .copy {
    position: relative;
    z-index: 1;
    grid-column: 6 / 13;
    grid-row: 1;
    padding-bottom: 8%;
  }
  .copy h2 {
    font-size: clamp(2.5rem, 6vw, 5.5rem);
    color: #fff;
    mix-blend-mode: difference;
  }
  .copy p:not(.label) { max-width: 34ch; margin-left: auto; }
  .copy .label, .copy .btn { display: table; margin-left: auto; }
  .copy { text-align: right; }
  .copy .hint { margin-bottom: 20px; color: var(--accent); }

  @media (hover: none) {
    .hint { display: none; }
  }

  @media (max-width: 860px) {
    .stage { grid-column: 1 / -1; }
    .copy { grid-column: 1 / -1; grid-row: 2; margin-top: 20px; padding-bottom: 0; text-align: left; }
    .copy p:not(.label) { margin-left: 0; }
    .copy .label, .copy .btn { margin-left: 0; }
  }
</style>
